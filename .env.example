# MySQL connection (Hostinger MySQL, or local MariaDB/MySQL for dev)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Random secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Single admin identity (no admin user-management UI/table).
# Generate ADMIN_PASSWORD_HASH with: npm run hash-password -- <password>
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Directory (relative or absolute) where uploaded logo files are stored.
UPLOADS_DIR=./uploads
