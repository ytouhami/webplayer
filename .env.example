# MySQL connection (Hostinger MySQL, or local MariaDB/MySQL for dev)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Random secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Random secret used to encrypt the end-user IPTV session cookie (holds their
# M3U/Xtream username+password, so this needs real secrecy, not just signing).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
